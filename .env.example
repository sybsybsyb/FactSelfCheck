# Example .env for scripts/evaluate_prompts.py
# Copy this file to .env and fill in your secrets. Do NOT commit your .env with real keys.

# Input prompts CSV and column name
PROMPTS_CSV=prompts.csv
PROMPT_COL=prompt

# Output CSV for results
OUTPUT_CSV=results.csv

# CSV delimiter (default is comma)
DELIMITER=,

# LLM endpoint URL (required)
ENDPOINT=https://api.openai.com/v1/chat/completions

# API key for the LLM service. You can also set LLM_API_KEY or OPENAI_API_KEY
API_KEY=

# Model name to send in payload (optional)
MODEL=

# How often to checkpoint (integer). Script appends each row but this controls extra checkpoints.
CHECKPOINT_INTERVAL=5

# Generation options
TEMPERATURE=0.0
MAX_TOKENS=

# Retry/backoff
MAX_RETRIES=3
BACKOFF=1.0

# Optional system prompt sent to the LLM (leave empty if not needed)
SYSTEM_PROMPT=

# Force a start index to resume from (optional). Leave empty to auto-resume.
START_INDEX=
